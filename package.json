{
  "name": "deepseek-harness-zh-cn",
  "version": "0.1.4",
  "type": "module",
  "description": "A Chinese-first plugin for DeepSeek Harness: reason (reasoning) and answer in Simplified Chinese by default.",
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "AGENTS.md.example"
  ],
  "keywords": [
