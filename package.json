      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imlishiyuan/deepseek-harness-zh-cn.git"
  },
  "homepage": "https://github.com/imlishiyuan/deepseek-harness-zh-cn#readme",
  "bugs": {
    "url": "https://github.com/imlishiyuan/deepseek-harness-zh-cn/issues"
  }
}
